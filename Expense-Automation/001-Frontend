#!/bin/bash

COMPONENT="Frontend"
LOG="/tmp/frontend.log"

source common.sh    #This source command will pull the common.sh file locally that has functions & variables we had declared


COLOUR installing nginx
dnf install nginx -y  &>> $LOG
stat $?

if [ -f proxy.conf ] ; then
   COLOUR proxy file found
   stat $?
else
   echo -e \e[31m Proxy file not found \e[0m
   exit 1
fi

COLOUR Copying proxy file
cp proxy.conf /etc/nginx/default.d/expense.conf &>> $LOG
stat $?


COLOUR Starting Nginx
systemctl enable nginx &>> $LOG
stat $?

COLOUR Performing a Cleanup
rm -rf /usr/share/nginx/html/* &>> $LOG
stat $?

COLOUR Downloading $COMPONENT
curl -o /tmp/$COMPONENT.zip https://expense-web-app.s3.amazonaws.com/frontend.zip &>> $LOG
cd /usr/share/nginx/html 
stat $?

COLOUR Extracting the $COMPONENT
unzip -o /tmp/$COMPONENT.zip &>> $LOG
stat $?

COLOUR Starting Nginx
systemctl restart nginx &>> $LOG
stat $? 

echo -e "\n\t** $COMPONENT Installation Is Completed **"


